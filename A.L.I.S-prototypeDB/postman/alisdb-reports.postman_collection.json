{
  "info": {
    "name": "ALISDB API - Auth, Books, Reports",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth / Public Signup (Borrower)",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "url": {"raw": "{{baseUrl}}/api/v1/auth/register", "host":["{{baseUrl}}"], "path":["api","v1","auth","register"]},
        "body": {"mode": "raw", "raw": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Student\",\n  \"email\": \"jane.signup@example.com\",\n  \"password\": \"password12345\",\n  \"confirm_password\": \"password12345\",\n  \"student_number\": \"STU-9001\"\n}"}
      }
    },
    {
      "name": "Auth / Login",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "url": {"raw": "{{baseUrl}}/api/v1/auth/login", "host":["{{baseUrl}}"], "path":["api","v1","auth","login"]},
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"}
      }
    },
    {
      "name": "Books / Create",
      "request": {
        "method": "POST",
        "header": [
          {"key":"Content-Type","value":"application/json"},
          {"key":"Authorization","value":"Bearer {{token}}"}
        ],
        "url": {"raw": "{{baseUrl}}/api/v1/books", "host":["{{baseUrl}}"], "path":["api","v1","books"]},
        "body": {"mode": "raw", "raw": "{\n  \"isbn\": \"9780000000013\",\n  \"title\": \"Status Test\",\n  \"author\": \"Author Two\",\n  \"year_published\": 2024,\n  \"category_id\": 1,\n  \"total_copies\": 1,\n  \"available_copies\": 1,\n  \"date_added\": \"2025-11-19T00:00:00Z\"\n}"}
      }
    },
    {
      "name": "Reports / Weekly Summary",
      "request": {
        "method": "GET",
        "header": [
          {"key":"Authorization","value":"Bearer {{token}}"}
        ],
        "url": {"raw": "{{baseUrl}}/api/v1/reports/weekly/summary?range=week", "host":["{{baseUrl}}"], "path":["api","v1","reports","weekly","summary"], "query":[{"key":"range","value":"week"}]}
      }
    },
    {
      "name": "Reports / Most Borrowed",
      "request": {
        "method": "GET",
        "header": [
          {"key":"Authorization","value":"Bearer {{token}}"}
        ],
        "url": {"raw": "{{baseUrl}}/api/v1/reports/weekly/most-borrowed?limit=5&range=week", "host":["{{baseUrl}}"], "path":["api","v1","reports","weekly","most-borrowed"], "query":[{"key":"limit","value":"5"},{"key":"range","value":"week"}]}
      }
    }
  ],
  "event": [],
  "variable": [
    {"key":"baseUrl","value":"http://127.0.0.1:8000"},
    {"key":"token","value":""}
  ]
}
